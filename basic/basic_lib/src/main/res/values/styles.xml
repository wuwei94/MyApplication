<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="base_AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/base_purple_500</item>
        <item name="colorOnPrimary">@color/base_white</item>
        <item name="colorPrimaryContainer">@color/base_purple_200</item>
        <item name="colorOnPrimaryContainer">@color/base_black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/base_teal_200</item>
        <item name="colorOnSecondary">@color/base_black</item>
        <item name="colorSecondaryContainer">@color/base_teal_200</item>
        <item name="colorOnSecondaryContainer">@color/base_black</item>
        <!-- Status bar and navigation bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Customize your theme here. -->
        <!-- 在 Android 15（API 35）中，系统默认启用了 edge-to-edge 无边框设计 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="base_SplashScreen" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="base_TranslucentTheme" parent="base_AppTheme">
        <!--不设置activity进入和退出动画样式-->
        <item name="android:windowAnimationStyle">@null</item>
        <!--设置窗口的背景是否为半透明，设置透明背景必须要设置此项-->
        <item name="android:windowIsTranslucent">true</item>
        <!--设置状态栏的背景为半透明-->
        <item name="android:windowTranslucentStatus">true</item>
        <!--设置导航栏的背景为半透明-->
        <item name="android:windowTranslucentNavigation">true</item>
        <!--设置窗口的背景为透明，设置透明背景必须要设置此项-->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="base_WindowAnimTheme_Slide" parent="base_AppTheme">
        <item name="android:windowAnimationStyle">@style/base_Activity_Translate_Slide</item>
    </style>

    <style name="base_Activity_Translate_Slide" parent="@android:style/Animation.Translucent">
        <item name="android:activityOpenEnterAnimation">@anim/base_anim_slide_in_left</item>
        <item name="android:activityOpenExitAnimation">@anim/base_anim_slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/base_anim_slide_in_right</item>
        <item name="android:activityCloseExitAnimation">@anim/base_anim_slide_out_right</item>
    </style>

    <style name="base_Dialog_Translate_Slide_Alpha" parent="@android:style/Animation.Translucent">
        <item name="android:windowEnterAnimation">@anim/base_anim_slide_alpha_in_top</item>
        <item name="android:windowExitAnimation">@anim/base_anim_slide_alpha_out_top</item>
    </style>

    <style name="base_ScrollViewStyle">
        <!--下拉时顶部出现的半月形阴影效果-->
        <item name="android:overScrollMode">never</item>
        <!--滑出控件边界时的虚化的效果-->
        <item name="android:fadingEdge">none</item>
        <!--滚动条-->
        <item name="android:scrollbars">none</item>
    </style>

    <style name="base_CustomBottomSheetDialogTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/base_CustomBottomSheetStyle</item>
    </style>

    <style name="base_CustomBottomSheetStyle" parent="@style/Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
