<?xml version="1.0" encoding="utf-8"?>
<!--
  Rive 播放画布：RiveAnimationView 铺满上方容器，深色底让透明素材显影（与 VAP / PAG 实验台同一考虑）。
  内部 TextureView isOpaque=false，透明区域透出的是外层容器底色，故背景挂外层。
  本布局始终 inflate 进 basics_response_container，不作为窗口根，Overdraw 告警的
  「根节点背景与窗口背景重复绘制」前提不成立，故抑制。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shared_color_console_bg"
    tools:ignore="Overdraw">

    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/anim_rive_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Rive 动画" />

</FrameLayout>
