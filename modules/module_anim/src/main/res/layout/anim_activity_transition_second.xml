<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 左上角 View -->
    <View
        android:layout_width="@dimen/shared_dp_avatar_size"
        android:layout_height="@dimen/shared_dp_avatar_size"
        android:layout_margin="@dimen/shared_dp_16"
        android:background="@color/shared_color_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 右上角 View -->
    <View
        android:layout_width="@dimen/shared_dp_avatar_size"
        android:layout_height="@dimen/shared_dp_avatar_size"
        android:layout_margin="@dimen/shared_dp_16"
        android:background="@color/shared_color_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 左下角 View -->
    <View
        android:layout_width="@dimen/shared_dp_avatar_size"
        android:layout_height="@dimen/shared_dp_avatar_size"
        android:layout_margin="@dimen/shared_dp_16"
        android:background="@color/shared_color_primary_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 右下角 View -->
    <View
        android:layout_width="@dimen/shared_dp_avatar_size"
        android:layout_height="@dimen/shared_dp_avatar_size"
        android:layout_margin="@dimen/shared_dp_16"
        android:background="@color/shared_color_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 中心按钮 -->
    <Button
        android:id="@+id/transition_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击返回"
        android:transitionName="shareTransition"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
