<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/shared_dp_16">

    <TextView
        android:id="@+id/widget_spinner_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自定义 Spinner 下拉弹窗选择演示"
        android:textColor="@color/shared_color_accent"
        android:textSize="@dimen/shared_sp_14"
        android:textStyle="bold" />

    <!-- 下拉选择框（作为 showAsDropDown 的真实锚点） -->
    <LinearLayout
        android:id="@+id/widget_spinner_anchor"
        android:layout_width="260dp"
        android:layout_height="@dimen/shared_dp_48"
        android:layout_marginTop="@dimen/shared_dp_16"
        android:background="@drawable/shared_bg_container_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/shared_dp_16">

        <TextView
            android:id="@+id/widget_spinner_selected_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="请选择所属类别..."
            android:textColor="@android:color/black"
            android:textSize="@dimen/shared_sp_14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="@color/shared_color_accent"
            android:textSize="@dimen/shared_sp_12" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_spinner_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_12"
        android:text="当前状态：未选择"
        android:textColor="@android:color/darker_gray"
        android:textSize="@dimen/shared_sp_12" />

</LinearLayout>
