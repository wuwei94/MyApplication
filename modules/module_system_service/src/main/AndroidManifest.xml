    <application>
        <activity android:name=".SystemServiceMainActivity" />
        <activity android:name=".notification.activity.NotificationActivity" />
        <activity android:name=".permission.activity.PermissionActivity" />
        <activity android:name=".permission.activity.PermissionXActivity" />
        <activity android:name=".floatwindow.activity.FloatWindowActivity" />
        <activity android:name=".floatwindow.activity.EasyFloatActivity" />
    </application>

</manifest>
