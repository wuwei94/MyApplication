<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/shared_dp_16"
    android:layout_marginVertical="@dimen/shared_dp_4"
    android:background="@drawable/shared_bg_container_border"
    android:orientation="vertical"
    android:padding="@dimen/shared_dp_12">

    <TextView
        android:id="@+id/sample_concat_feed_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        android:textSize="@dimen/shared_sp_14"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sample_concat_feed_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_4"
        android:textColor="@android:color/darker_gray"
        android:textSize="@dimen/shared_sp_12" />

</LinearLayout>
