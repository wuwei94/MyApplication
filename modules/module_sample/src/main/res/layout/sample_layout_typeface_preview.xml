<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/shared_dp_16">

    <TextView
        android:id="@+id/sample_typeface_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前字体：Typeface.DEFAULT"
        android:textColor="@color/shared_color_accent"
        android:textSize="@dimen/shared_sp_14"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sample_typeface_en"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_8"
        android:text="The quick brown fox jumps over the lazy dog"
        android:textColor="@android:color/black"
        android:textSize="@dimen/shared_sp_16" />

    <TextView
        android:id="@+id/sample_typeface_zh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_8"
        android:text="天地玄黄 宇宙洪荒 日月盈昃 辰宿列张"
        android:textColor="@android:color/black"
        android:textSize="@dimen/shared_sp_16" />

    <TextView
        android:id="@+id/sample_typeface_num"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_8"
        android:text="0123456789 • !@#$%^&amp;*()_+"
        android:textColor="@android:color/darker_gray"
        android:textSize="@dimen/shared_sp_14" />

</LinearLayout>
