<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部 HUD 性能与复用监控面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/shared_dp_16"
        android:layout_marginTop="@dimen/shared_dp_12"
        android:background="@drawable/shared_bg_container_border"
        android:orientation="vertical"
        android:padding="@dimen/shared_dp_12">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RecycledViewPool 跨 Tab 视图池共享监控"
            android:textColor="@android:color/black"
            android:textSize="@dimen/shared_sp_14"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sample_pool_stats_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/shared_dp_4"
            android:text="池容量上限: 15\nTab 1 创建数: 0 | Tab 2 创建数: 0\nTab 2 跨池复用数: 0"
            android:textColor="@color/shared_color_accent"
            android:textSize="@dimen/shared_sp_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/shared_dp_8"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sample_btn_clear_pool"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空共享池"
                android:textSize="@dimen/shared_sp_12" />

            <Button
                android:id="@+id/sample_btn_reset_stats"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/shared_dp_8"
                android:layout_weight="1"
                android:text="重置统计数据"
                android:textSize="@dimen/shared_sp_12" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/shared_dp_16"
        android:layout_marginTop="@dimen/shared_dp_8"
        android:text="👉 体验方式：先在 Tab 1 向下滑动 15+ 项产生回收 ViewHolder，随后切换至 Tab 2 下滑，观察 Tab 2 的新建数与复用数变化。"
        android:textColor="@android:color/darker_gray"
        android:textSize="@dimen/shared_sp_12" />

    <!-- Tab 导航 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/sample_pool_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_8"
        app:tabIndicatorColor="@color/shared_color_primary"
        app:tabSelectedTextColor="@android:color/black"
        app:tabTextColor="@android:color/darker_gray" />

    <!-- 双 Tab 列表 ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/sample_pool_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
