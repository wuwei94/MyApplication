<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/shared_bg_container_border"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/sample_async_card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="异步加载的卡片标题"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sample_async_card_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="该视图完全在子线程完成 XML 反序列化与 View 对象构建，构建完成后在主线程回调中挂载并绑定数据。"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp" />

</LinearLayout>
