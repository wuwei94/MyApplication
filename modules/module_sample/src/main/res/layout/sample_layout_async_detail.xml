<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/shared_dp_16">

    <!-- 顶部横幅占位 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/shared_bg_container_border"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sample_detail_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 详情页预加载视图（0ms 瞬间挂载）"
            android:textColor="@color/shared_color_accent"
            android:textSize="@dimen/shared_sp_14"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sample_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_12"
        android:text="高性能 Android 视图预加载架构演进实战"
        android:textColor="@android:color/black"
        android:textSize="@dimen/shared_sp_16"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sample_detail_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_8"
        android:text="本页面布局在列表页浏览期间已由 ViewPreloadManager 提前在后台异步线程解析完毕。进入详情页无需经历耗时的 XML 解析与反射流程，直接通过 ViewPreloadManager.getView() 瞬间取出挂载。"
        android:textColor="@android:color/darker_gray"
        android:textSize="@dimen/shared_sp_12" />

    <!-- 模拟操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_12"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sample_detail_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="预加载命中状态：命中 ViewPreloadManager 缓存池"
            android:textColor="@color/shared_color_accent"
            android:textSize="@dimen/shared_sp_12" />

        <Button
            android:id="@+id/sample_detail_btn"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="立即订阅"
            android:textSize="@dimen/shared_sp_12" />
    </LinearLayout>

</LinearLayout>
