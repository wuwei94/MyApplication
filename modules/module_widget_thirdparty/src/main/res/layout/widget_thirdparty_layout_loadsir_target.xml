<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/shared_dp_16">

    <TextView
        android:id="@+id/widget_thirdparty_loadsir_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ 成功加载：Android 架构模式与最佳实践"
        android:textColor="@color/shared_color_accent"
        android:textSize="@dimen/shared_sp_16"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_thirdparty_loadsir_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_8"
        android:text="这是一段成功加载的真实业务内容卡片。通过 LoadSir.register(contentView)，可无侵入接管该区域的 Loading 骨架、Error 重试与空页面切换。"
        android:textColor="@android:color/black"
        android:textSize="@dimen/shared_sp_14" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shared_dp_12"
        android:text="作者：WilliamWu • 分类：UI 库与多状态管理 • 点赞：999+"
        android:textColor="@android:color/darker_gray"
        android:textSize="@dimen/shared_sp_12" />

</LinearLayout>
