<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.RealtimeBlurViewActivity">

    <RelativeLayout
        android:id="@+id/blur_frame"
        android:layout_width="@dimen/shared_dp_image_size"
        android:layout_height="@dimen/shared_dp_image_size"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/shared_ic_launcher" />

        <com.github.mmin18.widget.RealtimeBlurView
            android:id="@+id/realtime_blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </RelativeLayout>

</FrameLayout>
