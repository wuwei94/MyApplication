<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.william.my.module.jetpack.activity.PagingActivity">

    <HorizontalScrollView
        android:id="@+id/mode_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:paddingHorizontal="@dimen/shared_dp_8"
        android:paddingVertical="@dimen/shared_dp_4"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mediator_flow"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/shared_dp_8"
                android:text="Mediator (Flow)"
                android:textSize="@dimen/shared_sp_12" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mediator_rx"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/shared_dp_8"
                android:text="Mediator (Rx)"
                android:textSize="@dimen/shared_sp_12" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_network_flow"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/shared_dp_8"
                android:text="Network (Flow)"
                android:textSize="@dimen/shared_sp_12" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_network_rx"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/shared_dp_8"
                android:text="Network (Rx)"
                android:textSize="@dimen/shared_sp_12" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_refresh"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新"
                android:textSize="@dimen/shared_sp_12" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/paging_recycleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mode_scroll_view" />

</androidx.constraintlayout.widget.ConstraintLayout>