<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      官方 2.x 样例中，语音识别 / 零样本分类 / 语音合成共五个页面的模型均为**运行时下载**
      （官方对应的 ModelDownloader / ModelMetadataManager），这些页面的模型资产不入 APK。
      本模块沿用同一策略，因此需要网络权限。
      注：数字/图像/文本分类与图像分割四个页面的小模型仍随 assets 内嵌。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 语音识别页的麦克风输入（文件输入不需要此权限，运行时按需申请） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <activity android:name=".MlMainActivity" />
        <activity android:name=".digit.TFLiteDigitClassifierActivity" />
        <activity android:name=".image.TFLiteImageClassificationActivity" />
        <activity android:name=".segmentation.TFLiteImageSegmentationActivity" />
        <activity android:name=".text.TFLiteTextClassificationActivity" />
        <activity android:name=".tts.TFLiteTextToSpeechActivity" />
        <activity android:name=".tts.TFLiteTextToSpeechStreamingActivity" />
        <activity android:name=".tts.TFLiteTextToSpeechLmActivity" />
        <activity android:name=".asr.TFLiteSpeechRecognitionActivity" />
        <activity android:name=".zsc.TFLiteZeroShotClassificationActivity" />
    </application>

</manifest>
