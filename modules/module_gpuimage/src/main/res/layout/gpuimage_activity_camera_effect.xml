<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX 取景层（经 CameraEffect 滤镜直接渲染） -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fitCenter" />

    <!-- 滤镜与控制面板容器 -->
    <LinearLayout
        android:id="@+id/layout_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gpuimage_overlay_bg"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 当前滤镜指示与说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CameraEffect 官方硬件滤镜录像"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="原图"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 滤镜水平滑动条 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp" />
        </HorizontalScrollView>

        <!-- 单一录像操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_record"
                android:layout_width="@dimen/shared_dp_56"
                android:layout_height="@dimen/shared_dp_56"
                android:background="@drawable/gpuimage_bg_circle_btn"
                android:contentDescription="录像"
                android:padding="@dimen/shared_dp_12"
                android:src="@drawable/gpuimage_ic_record_start" />
        </LinearLayout>
    </LinearLayout>

    <!-- 视频回放卡片（录像完成后弹出） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="@dimen/shared_dp_16"
        app:cardElevation="@dimen/shared_dp_8"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="@dimen/shared_dp_divider"
        tools:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 视频播放 TextureView -->
            <TextureView
                android:id="@+id/preview_texture"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 右上角关闭按钮 -->
            <ImageView
                android:id="@+id/btn_close_preview"
                android:layout_width="@dimen/shared_dp_32"
                android:layout_height="@dimen/shared_dp_32"
                android:layout_margin="@dimen/shared_dp_12"
                android:background="@drawable/gpuimage_bg_close_btn"
                android:contentDescription="关闭预览"
                android:elevation="@dimen/shared_dp_16"
                android:padding="@dimen/shared_dp_4"
                android:src="@drawable/gpuimage_ic_close"
                android:translationZ="@dimen/shared_dp_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
